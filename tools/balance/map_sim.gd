extends SceneTree
## World Map v2 map simulation (docs/design/world-map-v2/06-validation-plan.md section 2): generates region graphs
## over many seeds, validates every one, and prints the metrics the plan asks for. Pure generation, no combat.
## Usage: godot --headless --path . -s res://tools/balance/map_sim.gd -- [--seeds=10000] [--pairs=assigned|all]
##        [--regions=hellfire,...] [--seed-offset=0] [--cleared-bosses=1] [--kiep=0] [--force-v2]
## `assigned` = the 7 (region, floor) pairs of world.region_order (floor = position); `all` = every region at every
## floor (informational). Without --force-v2 a v1 region is generated by ChapterMapGen and wrapped (so the tool also
## checks the wrapper); with it every region goes through RegionMapGen (the generator must accept any pair).
## Output: one block per pair (BLOCK rows first, INFO rows after), then a TOTAL block and a FAILED SEEDS list.
## Balance validation 2026-11-12: a v2 pair also prints ARCH rows — per archetype its appearance rate (maps holding it),
## the lane (screen order) it landed on, the kinds its slots rolled (depths 1 / 2 / 4) — plus the hostile-archetype
## count per map (hostile = peril, elite), the maps with a repeated archetype, the safe / treasure guarantee misses
## and the gamble kind. "inaccessible" = an archetype the templates allow on the floor that never appeared.

const SEED_MASK: int = 0x7fffffff

var _seeds: int = 10000
var _seed_offset: int = 0
var _pairs_mode: String = "assigned"
var _regions_filter: Array[String] = []
var _cleared_bosses: int = 1
var _kiep: int = 0
var _force_v2: bool = false


func _initialize() -> void:
	for arg: String in OS.get_cmdline_user_args():
		var v: String = arg.get_slice("=", 1) if arg.contains("=") else ""
		if arg.begins_with("--seeds="):
			_seeds = maxi(int(v), 1)
		elif arg.begins_with("--seed-offset="):
			_seed_offset = int(v)
		elif arg.begins_with("--pairs="):
			_pairs_mode = v
		elif arg.begins_with("--regions="):
			_regions_filter.assign(v.split(","))
		elif arg.begins_with("--cleared-bosses="):
			_cleared_bosses = int(v)
		elif arg.begins_with("--kiep="):
			_kiep = int(v)
		elif arg == "--force-v2":
			_force_v2 = true
	var cfg: ChaptersConfig = ChaptersConfig.load_from_file()
	var rules: RegionRules = RegionRules.shared()
	var pairs: Array = []
	if _pairs_mode == "all":
		for region: String in cfg.region_ids():
			for f: int in cfg.world_floors():
				pairs.append([region, f])
	else:
		var order: Array[String] = cfg.region_order()
		for f: int in order.size():
			pairs.append([order[f], f])
	if not _regions_filter.is_empty():
		pairs = pairs.filter(func(p: Array) -> bool: return _regions_filter.has(str(p[0])))
	print("map_sim: seeds=%d offset=%d pairs=%s (%d) cleared_bosses=%d kiep=%d force_v2=%s depth_layout=%s" % [
		_seeds, _seed_offset, _pairs_mode, pairs.size(), _cleared_bosses, _kiep, str(_force_v2), str(rules.depth_layout)])
	var total_maps: int = 0
	var total_fail: int = 0
	var failed_seeds: Array[String] = []
	var all_times: Array[float] = []
	for pair: Array in pairs:
		var region: String = str(pair[0])
		var floor: int = int(pair[1])
		var v2: bool = _force_v2 or rules.uses_v2(region)
		var spec: Dictionary = cfg.region_graph_spec(region, 0, floor, _cleared_bosses, _kiep)
		spec["floor_number"] = floor + 1
		# The archetype floor rule (01 section A4) is a v2 rule: a v1 column map may hold danger in columns 3-5 on floor
		# 1 by its own data (region_columns), so a wrapped v1 map is checked against its pools only.
		if v2:
			spec["kind_floors"] = {"danger": {"min_floor": 2}, "miniboss": {"min_floor": 2}}
		var maps: int = 0
		var fails: int = 0
		var reach_fail: int = 0
		var determinism_fail: int = 0
		var triples: Dictionary = {}
		var identical_lanes: int = 0
		var lane_repeat_maps: int = 0
		var distinct_sum: int = 0
		var shops: int = 0
		var events_over: int = 0
		var hub_kinds: Dictionary = {}
		var times: Array[float] = []
		var kinds_total: Dictionary = {}
		var arch_maps: Dictionary = {}
		var arch_lane: Dictionary = {}
		var arch_slot_kinds: Dictionary = {}
		var hostile_count: Array[int] = [0, 0, 0, 0]
		var repeated_arch: int = 0
		var guarantee_miss: int = 0
		var gamble_kinds: Dictionary = {}
		var archetypes: RouteArchetypes = RouteArchetypes.shared()
		for s: int in _seeds:
			var run_seed: int = (s + 1 + _seed_offset) & SEED_MASK
			var t0: int = Time.get_ticks_usec()
			var g: MapGraph = cfg.generate_region_graph(region, run_seed, floor, _cleared_bosses, _kiep, _force_v2)
			var dt: float = float(Time.get_ticks_usec() - t0) / 1000.0
			times.append(dt)
			all_times.append(dt)
			maps += 1
			if g == null:
				fails += 1
				failed_seeds.append("%s f%d seed %d: null graph" % [region, floor + 1, run_seed])
				continue
			var vspec: Dictionary = spec
			vspec["guarantee_shop"] = cfg.shop_floors(run_seed).has(clampi(floor, 0, cfg.world_floors() - 1))
			var res: Dictionary = MapValidator.validate(g, vspec)
			if not bool(res["ok"]):
				fails += 1
				for e: String in res["errors"]:
					if e.begins_with("reach:"):
						reach_fail += 1
						break
				if failed_seeds.size() < 200:
					failed_seeds.append("%s f%d seed %d: %s" % [region, floor + 1, run_seed, str(res["errors"]).left(160)])
			if s < 100:
				var g2: MapGraph = cfg.generate_region_graph(region, run_seed, floor, _cleared_bosses, _kiep, _force_v2)
				if g2 == null or g2.to_dict() != g.to_dict():
					determinism_fail += 1
			var m: Dictionary = MapValidator.metrics(g)
			if v2:
				triples[str(m["archetypes"])] = int(triples.get(str(m["archetypes"]), 0)) + 1
				if int(m["lane_repeats"]) > 0:
					lane_repeat_maps += 1
				if _identical_lanes(g):
					identical_lanes += 1
				var hub_kind: String = str(g.nodes[RegionMapGen.ID_HUB]["kind"]) if g.has_node(RegionMapGen.ID_HUB) else "?"
				hub_kinds[hub_kind] = int(hub_kinds.get(hub_kind, 0)) + 1
				if hub_kind == "shop" and bool(vspec["guarantee_shop"]):
					shops += 1
				elif hub_kind == "shop" or bool(vspec["guarantee_shop"]):
					fails += 1
					if failed_seeds.size() < 200:
						failed_seeds.append("%s f%d seed %d: shop plan %s but hub %s" % [region, floor + 1, run_seed, str(vspec["guarantee_shop"]), hub_kind])
				_arch_stats(g, arch_maps, arch_lane, arch_slot_kinds, hostile_count, gamble_kinds, archetypes)
				if int(m["lane_repeats"]) > 0 or _repeated_archetype(g):
					repeated_arch += 1 if _repeated_archetype(g) else 0
				if not _has_guarantee(g, archetypes):
					guarantee_miss += 1
			distinct_sum += int(m["distinct_match_ids"])
			var kinds: Dictionary = m["kinds"]
			for k: Variant in kinds.keys():
				kinds_total[str(k)] = int(kinds_total.get(str(k), 0)) + int(kinds[k])
			if int(kinds.get("event", 0)) > 2:
				events_over += 1
		total_maps += maps
		total_fail += fails
		times.sort()
		print("")
		print("PAIR %s floor %d (%s): maps=%d" % [region, floor + 1, "v2" if v2 else "v1-wrapped", maps])
		print("  BLOCK valid=%d/%d (%.2f %%) reach_fail=%d determinism_fail(first 100 x2)=%d events>2=%d" % [maps - fails, maps, 100.0 * float(maps - fails) / maxf(float(maps), 1.0), reach_fail, determinism_fail, events_over])
		print("  BLOCK gen_ms p50=%.3f p95=%.3f max=%.3f" % [_pct(times, 0.5), _pct(times, 0.95), times[times.size() - 1]])
		if v2:
			var tri_list: Array = []
			for k: Variant in triples.keys():
				tri_list.append("%s=%d" % [k, int(triples[k])])
			tri_list.sort()
			print("  INFO archetype_triples=%d: %s" % [triples.size(), ", ".join(PackedStringArray(tri_list))])
			print("  INFO identical_lane_profiles=%d (%.2f %%) lane_match_repeats=%d (%.2f %%) hub=%s shop_plan_hits=%d" % [
				identical_lanes, 100.0 * float(identical_lanes) / maxf(float(maps), 1.0), lane_repeat_maps, 100.0 * float(lane_repeat_maps) / maxf(float(maps), 1.0), str(hub_kinds), shops])
		print("  INFO distinct_match_ids_mean=%.2f kinds=%s" % [float(distinct_sum) / maxf(float(maps), 1.0), str(kinds_total)])
		if v2:
			var legal: Array[String] = []
			for id: String in archetypes.ids():
				if archetypes.min_floor(id) <= floor + 1 and archetypes.weight(id, rules.archetype_weights(region)) > 0.0:
					legal.append(id)
			var inaccessible: Array[String] = []
			for id: String in legal:
				var n_maps: int = int(arch_maps.get(id, 0))
				var lanes: Array = arch_lane.get(id, [0, 0, 0])
				var slot_txt: Array[String] = []
				var slots: Dictionary = arch_slot_kinds.get(id, {})
				var depths: Array = slots.keys()
				depths.sort()
				for d: Variant in depths:
					var kinds_d: Dictionary = slots[d]
					var cells: Array[String] = []
					var ks: Array = kinds_d.keys()
					ks.sort()
					for k: Variant in ks:
						cells.append("%s=%d" % [str(k), int(kinds_d[k])])
					slot_txt.append("d%d{%s}" % [int(d), ",".join(PackedStringArray(cells))])
				print("  ARCH %s: maps=%d (%.2f %%) lane0/1/2=%d/%d/%d slots: %s" % [id, n_maps, 100.0 * float(n_maps) / maxf(float(maps), 1.0),
					int(lanes[0]), int(lanes[1]), int(lanes[2]), " ".join(PackedStringArray(slot_txt))])
				if n_maps == 0:
					inaccessible.append(id)
			print("  ARCH hostile_per_map(0/1/2/3)=%d/%d/%d/%d three_hostile=%.2f %% repeated_archetype_maps=%d guarantee_miss(no safe, no treasure)=%d gamble=%s inaccessible=%s" % [
				hostile_count[0], hostile_count[1], hostile_count[2], hostile_count[3], 100.0 * float(hostile_count[3]) / maxf(float(maps), 1.0),
				repeated_arch, guarantee_miss, str(gamble_kinds), str(inaccessible) if not inaccessible.is_empty() else "none"])
	all_times.sort()
	print("")
	print("TOTAL maps=%d valid=%d (%.3f %%) gen_ms p50=%.3f p95=%.3f" % [total_maps, total_maps - total_fail, 100.0 * float(total_maps - total_fail) / maxf(float(total_maps), 1.0), _pct(all_times, 0.5), _pct(all_times, 0.95)])
	print("FAILED SEEDS (%d listed of %d):" % [failed_seeds.size(), total_fail])
	for line: String in failed_seeds:
		print("  " + line)
	quit(1 if total_fail > 0 else 0)


# Balance validation 2026-11-12: per-map archetype bookkeeping (see the header).
func _arch_stats(g: MapGraph, arch_maps: Dictionary, arch_lane: Dictionary, arch_slot_kinds: Dictionary,
		hostile_count: Array[int], gamble_kinds: Dictionary, archetypes: RouteArchetypes) -> void:
	var hostile: int = 0
	for i: int in g.lanes.size():
		var lane: Dictionary = g.lanes[i]
		var arch: String = str(lane.get("archetype", ""))
		arch_maps[arch] = int(arch_maps.get(arch, 0)) + 1
		if not arch_lane.has(arch):
			arch_lane[arch] = [0, 0, 0]
		var order: int = clampi(int(lane.get("order", i)), 0, 2)
		(arch_lane[arch] as Array)[order] = int((arch_lane[arch] as Array)[order]) + 1
		if arch == RouteArchetypes.PERIL or arch == "elite":
			hostile += 1
		if not arch_slot_kinds.has(arch):
			arch_slot_kinds[arch] = {}
		for id: String in g.node_ids():
			var n: Dictionary = g.nodes[id]
			if str(n.get("lane", "")) != str(lane["id"]):
				continue
			var d: int = int(n.get("depth", 0))
			var per_depth: Dictionary = arch_slot_kinds[arch]
			if not per_depth.has(d):
				per_depth[d] = {}
			var kinds_d: Dictionary = per_depth[d]
			var k: String = str(n.get("kind", ""))
			kinds_d[k] = int(kinds_d.get(k, 0)) + 1
	hostile_count[clampi(hostile, 0, 3)] += 1
	var gamble: String = str(g.nodes[RegionMapGen.ID_GAMBLE]["kind"]) if g.has_node(RegionMapGen.ID_GAMBLE) else "?"
	gamble_kinds[gamble] = int(gamble_kinds.get(gamble, 0)) + 1


# True when two lanes carry the same archetype (the validator forbids it; counted so a regression shows).
func _repeated_archetype(g: MapGraph) -> bool:
	var seen: Dictionary = {}
	for lane: Dictionary in g.lanes:
		var a: String = str(lane.get("archetype", ""))
		if seen.has(a):
			return true
		seen[a] = true
	return false


# True when at least one lane is one of the guaranteed archetypes (safe / treasure).
func _has_guarantee(g: MapGraph, archetypes: RouteArchetypes) -> bool:
	for lane: Dictionary in g.lanes:
		if archetypes.guarantee().has(str(lane.get("archetype", ""))):
			return true
	return false


# True when two lanes have the same (kind, reward_tier) sequence.
func _identical_lanes(g: MapGraph) -> bool:
	var profiles: Dictionary = {}
	for lane: Dictionary in g.lanes:
		var key: Array = []
		for id: String in g.node_ids():
			var n: Dictionary = g.nodes[id]
			if str(n["lane"]) == str(lane["id"]):
				key.append("%s:%d" % [str(n["kind"]), int(n["reward_tier"])])
		var k: String = "|".join(PackedStringArray(key))
		if profiles.has(k):
			return true
		profiles[k] = true
	return false


func _pct(sorted_values: Array[float], p: float) -> float:
	if sorted_values.is_empty():
		return 0.0
	var i: int = clampi(int(floor(p * float(sorted_values.size() - 1))), 0, sorted_values.size() - 1)
	return sorted_values[i]
